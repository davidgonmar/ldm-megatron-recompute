+        n, g, k, R = self.n, self.groups, self.key_dim, self.record_slots
+        region = streams[1:].reshape(-1).view(torch.uint8)
+        size = R * n * self.width * 2
+        views = {"residuals": region[:size].view(torch.bfloat16).view(R, n, g, self.value_dim)}
+        offset = size
+        for name, words in self.small_parts:
+            shape = (R, n, g, k) if words == g * k else (R, n, g)
+            size = R * n * words * 4
+            views[name] = region[offset:offset + size].view(torch.float32).view(shape)
+            offset += size

+class CuteRecomputeWorkspace(CuteDepthMemoryWorkspace):
+    """The kernels under full activation recompute (Megatron's ``depth_memory_unwind`` with
+    ``depth_memory_impl: cute``). Nothing of the state is checkpointed: the per-edge tapes travel
+    in the residual stream, the way mHC's streams do, and the backward reads them there.
+
+    Stream. ``[x, records]``, slot first ([slots, ..., h]). The slots past x are one byte
+    region: the BF16 u of the group's edges [edges, ..., g, d], then their keys, queries, gains,
+    denominators, forgetting and scales, each a contiguous FP32 block (``stream_slots``). So a group's records are the kernels' tapes as they are. Megatron
+    checkpoints, and offloads, every group's input stream like any residual: a group's input
+    holds the records of the group before it, the final stream those of the last group.
+
+    Forward: edges 0 .. L-1 in order, the kernels and their windows of ``span`` unchanged (the
+    forward is the one without recompute, bit for bit); ``put_record`` copies the edge's tapes
+    into the stream. Backward: the collapse before the LM head and then the first read of each
+    recomputed group hand the workspace the stream that holds the previous group's records
+    (``ingest``); it keeps a reference while their windows' backward runs. A recomputed write
+    writes nothing, a recomputed read comes from the running state, which is at a window
+    boundary (the read kernel). ``backward(edge)`` runs the window-end and interior launches as
+    without recompute: M by subtraction, P by addition from the FP32 running covariance.
+
+    Backward windows. The backward of edge e runs in the backward of the site that reads e, the
+    one writing e + 1 (the collapse for the last edge), so a window's window-end launch runs once
+    the group after its last edge has been recomputed. The backward needs only the final state
+    and the tapes, so its windows are the recompute groups, cut into pieces of at most ``span``
+    edges, whatever the forward's.
+
+    Memory. The forward holds M, P and its window of tapes; the backward M, P, their gradients,
+    the work buffers of one window and, past what Megatron holds, at most one group's input
+    stream. All of it is freed when the backward is done.
+    """
+
+    _TAPES = ("keys", "queries", "gains", "residuals", "denominators", "forgetting_tape", "scales")
+    _BUFFERS = ("m", "p", "dm", "covariance_grad", "p_scratch", "future_value_grad", "dy", "dv",
+                "future_gain_grad")
+
+    def __init__(self, **settings):
+        super().__init__(**settings)
+        if self.padded_value_dim != self.value_dim:
+            raise ValueError("cute_ldm recompute: the value dimension must be a multiple of 8")
+        self.windows = None
+
+    # -- layout --------------------------------------------------------------------------------
+    def layout(self, groups, width: int) -> None:
+        """``groups``: the (first edge, edge count) of every recompute group in order, edge 0
+        (the embedding write) a group of its own; ``width``: the stream's width h."""
+        groups = [(first, count) for first, count in groups if count > 0]
+        edges = [e for first, count in groups for e in range(first, first + count)]
+        if edges != list(range(self.total_edges)) or groups[0] != (0, 1):
+            raise ValueError(f"cute_ldm recompute: groups {groups} do not cover edges "
+                             f"0 .. {self.total_edges - 1} in order with edge 0 alone")
+        if width != self.groups * self.value_dim:
+            raise ValueError(f"cute_ldm recompute: stream width {width} is not "
+                             f"{self.groups} x {self.value_dim}")
+        L = self.total_edges
+        self.group_ranges = [(first, first + count) for first, count in groups]
+        self.group_of = [g for g, (first, end) in enumerate(self.group_ranges) for _ in range(first, end)]
+        self.forward_windows = [(s, min(s + self.span, L)) for s in range(0, L, self.span)]
+        self.windows = [(s, min(s + self.span, end)) for first, end in self.group_ranges
+                        for s in range(first, end, self.span)]
+        self.window_of = [w for w, (s, e) in enumerate(self.windows) for _ in range(s, e)]
+        self.width = width
+        self.record_slots = max(count for _, count in groups)
+        g, k = self.groups, self.key_dim
+        self.small_parts = (("keys", g * k), ("queries", g * k), ("gains", g * k),
+                            ("denominators", g), ("forgetting_tape", g), ("scales", g))
+        self.small_words = sum(words for _, words in self.small_parts)   # FP32 words per edge
+        self.n = None
+
+    def stream_slots(self, dtype) -> int:
+        """The width of the stream in slots of h: x, then the records of a group's edges (per
+        edge and token, u in BF16 and the other tapes in FP32)."""
+        record_bytes = self.record_slots * (2 * self.width + 4 * self.small_words)
+        return 1 + -(-record_bytes // (self.width * dtype.itemsize))

universe        = vanilla
executable      = /fast/dmartinez/oellm-ldm-work/scripts/bench_seq.sh
arguments       = "$(mbs) $(arms)"
environment     = "CLUSTER=$(Cluster)"
initialdir      = /fast/dmartinez/oellm-ldm-work
getenv          = False
request_gpus    = 4
request_cpus    = 32
request_memory  = 400GB
request_disk    = 100GB
requirements    = (CUDADeviceName == "NVIDIA B200") && (Machine != "i306.internal.cluster.is.localnet") && (Machine != "i307.internal.cluster.is.localnet")
log             = /fast/dmartinez/oellm-ldm-work/logs/seq-$(Cluster).log
output          = /fast/dmartinez/oellm-ldm-work/logs/seq-$(Cluster).out
error           = /fast/dmartinez/oellm-ldm-work/logs/seq-$(Cluster).err
queue

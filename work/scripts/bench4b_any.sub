universe        = vanilla
executable      = /fast/dmartinez/oellm-ldm-work/scripts/bench.sh
arguments       = "$(arm) $(mbs) 4"
initialdir      = /fast/dmartinez/oellm-ldm-work
getenv          = False
request_gpus    = 4
request_cpus    = 32
request_memory  = 400GB
request_disk    = 100GB
requirements    = (CUDADeviceName == "NVIDIA B200") && (Machine != "i306.internal.cluster.is.localnet")
log             = /fast/dmartinez/oellm-ldm-work/logs/bench4b-$(arm)-m$(mbs)-$(Cluster).log
output          = /fast/dmartinez/oellm-ldm-work/logs/bench4b-$(arm)-m$(mbs)-$(Cluster).out
error           = /fast/dmartinez/oellm-ldm-work/logs/bench4b-$(arm)-m$(mbs)-$(Cluster).err
queue
